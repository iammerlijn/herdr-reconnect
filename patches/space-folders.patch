@@ -15,6 +15,19 @@ import { View, div, svg } from "gpui-kit";
 import { v_flex, h_flex, InputState, Input } from "gpui-base";
 import { spaces, machines, panes, run, openOverlay, closeOverlay, props, exec, hc, theme, shared, setShared, watchFolder, window, layout, pickFolder, home, nextCommand } from "herdr";
 
+// herdr-reconnect (github.com/iammerlijn/herdr-reconnect): asks ssh for the
+// machine's Tailscale SSH check page and opens it in the browser. The target
+// comes from `hc machine ls`; nothing is stored. BatchMode: ssh never prompts.
+// Only a login.tailscale.com URL is opened. ssh keeps waiting until the login
+// is done (or the timeout); Herdr then reconnects by itself.
+function openLogin(target) {
+  const script = `ssh -o BatchMode=yes -o ConnectTimeout=10 -- "$1" true 2>&1 | grep -m1 -oE '^# To authenticate, visit: https://login\\.tailscale\\.com/[A-Za-z0-9/]+' | while read -r _ _ _ _ url; do open "$url" 2>/dev/null || xdg-open "$url"; done`;
+  exec("sh", ["-c", script, "sh", target], { timeout: 300000 }).catch(() => {});
+}
+
+// Machines the login button is for: saved over plain ssh, and not connected.
+const loginable = (machine) => machine && !machine.via && machine.target && machine.state !== "connected" && machine.state !== "needs_login";
+
 // A machine's folders live in a file in its home, so every screen showing its
 // spaces shows the same folders: { list: [{ id, name, folded }], of: { spaceId:
 // folderId }, at }, with space ids as that machine knows them. While this runs,
@@ -222,6 +235,7 @@ export default class Spaces extends View {
       for (;;) {
         const c = String(await nextCommand()).split(".").pop();
         if (c === "next" || c === "prev") this.step(c === "next" ? 1 : -1);
+        if (c === "login") for (const m of this.machines) if (loginable(m)) openLogin(m.target);
         cx.notify();
       }
     });
@@ -683,6 +697,9 @@ export default class Spaces extends View {
       .child(svg(`mods/workspace-chrome/${m ? "server" : "monitor"}.svg`).size(13).flex_none())
       .when(!collapsed, el => el.child(div().flex_1().truncate().child(m ?? "This computer"))
         .when(!connected, el => el.child(div().flex_none().child((machine?.state ?? "asleep").replace(/_/g, " "))))
+        .when(!!m && loginable(machine), el => el.child(div().id(`machine-login-${m}`).flex_none().px(3).rounded(4)
+          .hover(s => s.bg(t.hover).text_color(t.foreground)).tooltip("Log in with Tailscale (opens the browser)")
+          .on_click((_e, cx) => { cx.stop_propagation(); openLogin(machine.target); }).child(svg("mods/space-folders/rotate-cw.svg").size(12))))
         .when(connected, el => el.child(div().id(`machine-folder-${m ?? "local"}`).flex_none().px(3).rounded(4).hover(s => s.bg(t.hover).text_color(t.foreground))
           .on_click((_e, cx) => { cx.stop_propagation(); this.newFolder(m); }).child(svg("mods/workspace-chrome/folder-plus.svg").size(12))))
         .when(connected, el => el.child(div().id(`machine-add-${m ?? "local"}`).flex_none().px(4).rounded(4).hover(s => s.bg(t.hover).text_color(t.foreground))
