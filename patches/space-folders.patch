         .when(!connected, el => el.child(div().flex_none().child((machine?.state ?? "asleep").replace(/_/g, " "))))
+        .when(!!m && loginable(machine), el => el.child(Button.new(`machine-login-${m}`).flex_none().px(3).rounded(4).tab_index(0)
+          .accessibility_label(loggingIn.has(m) ? `Waiting for the Tailscale login for ${m}` : `Log in to ${m} with Tailscale`)
+          .tooltip(loggingIn.has(m) ? "Waiting for the login in the browser…" : "Log in with Tailscale (opens the browser)")
+          .disabled(loggingIn.has(m)).when(loggingIn.has(m), el => el.opacity(0.4))
+          .when(!loggingIn.has(m), el => el.hover(s => s.bg(t.hover).text_color(t.foreground)))
+          .on_click((_e, cx) => { cx.stop_propagation(); openLogin(machine, cx); }).child(svg("mods/space-folders/rotate-cw.svg").size(12))))
         .when(connected, el => el.child(div().id(`machine-folder-${m ?? "local"}`).flex_none().px(3).rounded(4).hover(s => s.bg(t.hover).text_color(t.foreground))
           .on_click((_e, cx) => { cx.stop_propagation(); this.newFolder(m); }).child(svg("mods/workspace-chrome/folder-plus.svg").size(12))))
         .when(connected, el => el.child(div().id(`machine-add-${m ?? "local"}`).flex_none().px(4).rounded(4).hover(s => s.bg(t.hover).text_color(t.foreground))
